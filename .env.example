# NewAngle — Environment Configuration Template
#
# Copy this file to `.env` and fill in real values locally.
# Never commit `.env` (it is already excluded via .gitignore).
#
# This file only lists configuration that is actually planned/decided
# per docs/architecture/overview.md. It will grow as real components
# (database, data connectors, API, frontend) are implemented — do not
# add speculative variables for integrations that don't exist yet.

# --- Application ---
# One of: development, test, production
ENVIRONMENT=development

# --- Database (PostgreSQL — see packages/data/README.md) ---
# Used by newangle-data (packages/data) for the SQLAlchemy engine and
# Alembic migrations as of Phase 1. Note the driver is psycopg 3
# ("postgresql+psycopg://"), not the bare "postgresql://" scheme.
DATABASE_URL=postgresql+psycopg://newangle:newangle_dev@localhost:5432/newangle_dev

# --- Test database (used only by packages/data's test suite) ---
# See packages/data/README.md "Setup" for how to create these databases.
# TEST_ADMIN_DATABASE_URL must point at a database that exists (Postgres's
# default "postgres" maintenance database works) and whose role has
# CREATEDB, since test_migrations.py creates/drops its own scratch
# database per run.
TEST_DATABASE_URL=postgresql+psycopg://newangle:newangle_dev@localhost:5432/newangle_test
TEST_ADMIN_DATABASE_URL=postgresql://newangle:newangle_dev@localhost:5432/postgres
